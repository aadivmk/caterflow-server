# Copy to .env for local runs. On Render, set these in the service Environment tab.
# Do not commit .env.

MONGODB_URI=
MONGODB_DB=caterflow
JWT_SECRET=

# Comma-separated frontend origins. Example:
# https://your-app.vercel.app,http://localhost:3000
# Leave empty to allow any origin (fine while you are connecting the first time).
CLIENT_ORIGIN=

PORT=4000
